# Copy to .env.local when ready. Do not commit real secrets.

# Optional AI recommendation engine
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MONTHLY_BUDGET_USD=10

# Google Calendar OAuth/client configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8765/google/callback
GOOGLE_CALENDAR_ID=primary

# Spotify OAuth/client configuration
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8765/callback

# Travel/music providers
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
TICKETMASTER_API_KEY=
